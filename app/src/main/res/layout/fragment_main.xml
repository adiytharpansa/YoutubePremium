<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <org.schabi.newpipe.views.ScrollableTabLayout
        android:id="@+id/main_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/windowBackground"
        app:tabRippleColor="@android:color/transparent"
        app:tabBackground="@drawable/chip_tab_background"
        app:tabIndicatorColor="#FC6401"
        app:tabIndicatorHeight="0dp"
        app:tabTextColor="@color/chip_text"
        app:tabSelectedTextColor="@color/chip_text_selected"
        app:tabTextAppearance="@style/EggPlayTabText"
        app:tabPaddingStart="12dp"
        app:tabPaddingEnd="12dp"
        app:tabGravity="fill"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        app:tabMinWidth="60dp" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_tab_layout" />

</RelativeLayout>
