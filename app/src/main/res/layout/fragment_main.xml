<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <org.schabi.newpipe.views.ScrollableTabLayout
        android:id="@+id/main_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/windowBackground"
        app:tabRippleColor="@color/white"
        app:tabIndicatorColor="#FC6401"
        app:tabIndicatorHeight="3dp"
        app:tabTextColor="@color/yt_tab_text"
        app:tabSelectedTextColor="@color/yt_tab_text_selected"
        app:tabTextAppearance="@style/EggPlayTabText"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp"
        app:tabGravity="fill"
        app:tabMinWidth="60dp" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_tab_layout" />

</RelativeLayout>
