<?xml version="1.0" encoding="utf-8"?>
<!--
  eggplay launcher foreground (Logo C): an egg split white / orange
  with a play triangle cut out in the centre. Original artwork for eggplay.
  SPDX-License-Identifier: GPL-3.0-or-later
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left half of the egg: white -->
    <group>
        <clip-path android:pathData="M20,0 L54,0 L54,108 L20,108 Z" />
        <path
            android:pathData="M54,20 C63,20 77,38 77,57 C77,74 66,88 54,88 C42,88 31,74 31,57 C31,38 43,20 54,20 Z"
            android:fillColor="#F6F6F6" />
    </group>

    <!-- Right half of the egg: orange -->
    <group>
        <clip-path android:pathData="M54,0 L88,0 L88,108 L54,108 Z" />
        <path
            android:pathData="M54,20 C63,20 77,38 77,57 C77,74 66,88 54,88 C42,88 31,74 31,57 C31,38 43,20 54,20 Z"
            android:fillColor="#FC6401" />
    </group>

    <!-- Play triangle, in the background colour so it reads as a cut-out -->
    <path
        android:pathData="M43,42 L69,54 L43,66 Z"
        android:fillColor="#27292D" />
</vector>
